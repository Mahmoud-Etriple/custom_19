<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Odoo 19 renders groups through res.groups.privilege;
            res.groups.category_id no longer exists.
        -->
        <record id="res_groups_privilege_expense_cancel" model="res.groups.privilege">
            <field name="name">Expense Cancellation</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="sequence">60</field>
            <field name="description">Controls who may cancel submitted, approved, posted or paid expenses.</field>
            <field name="placeholder">Not allowed</field>
        </record>

        <record id="group_hr_expense_cancel" model="res.groups">
            <field name="name">Cancel Expenses</field>
            <field name="privilege_id" ref="res_groups_privilege_expense_cancel"/>
            <field name="comment">Members may cancel expenses past the draft stage, including paid ones. Posted journal entries are reversed rather than deleted.</field>
            <field name="implied_by_ids" eval="[Command.link(ref('hr_expense.group_hr_expense_manager'))]"/>
        </record>
    </data>
</odoo>

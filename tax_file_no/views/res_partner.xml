        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code"/>
            </field>
        </field>
    </record>

    <record id="inherit_res_partner_industry_form" model="ir.ui.view">
        <field name="name">inherit.res.partner.industry.form</field>
        <field name="model">res.partner.industry</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="base.res_partner_industry_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code"/>
            </field>
        </field>
    </record>



<data>
    <record id="inherit_res_partner_form" model="ir.ui.view">
        <field name="name">inherit.res.partner.form</field>
        <field name="model">res.partner</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="industry_id" position="before">
                <field name="industry_code"/>
            </field>
        </field>
    </record>

    <record id="inherit_res_partner_industry_tree" model="ir.ui.view">
        <field name="name">inherit.res.partner.industry.tree</field>
        <field name="model">res.partner.industry</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->

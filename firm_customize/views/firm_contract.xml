<data>
    <record id="firm_contract_form" model="ir.ui.view">
        <field name="name">firm.contract.form</field>
        <field name="model">firm.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="parent_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_type"/>
                            <field name="person_legal_form" invisible="company_type != 'person'"/>
                            <field name="legal_form" invisible="company_type == 'person'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="documents_alerts" string="Documents / Alerts">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_document_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="name"/>
                                    <field name="document_type_id"/>
                                    <field name="issuing_office_id"/>
                                    <field name="state"/>
                                    <field name="last_update_date"/>
                                    <field name="alert_days"/>
                                    <field name="alert_users_ids" widget="many2many_tags" />
                                    <field name="folder_path"/>
                                </list>
                            </field>
                        </page>
                        <page name="services_pricing" string="Services / Pricing">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_services_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="category_id"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>

                        <page name="tax_gates" string="Tax Gates">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_tax_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="gate_link"/>
                                    <field name="user_name"/>
                                    <field name="password"/>
                                </list>
                            </field>
                        </page>


                    </notebook>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="firm_contract_tree" model="ir.ui.view">
        <field name="name">firm.contract.tree</field>
        <field name="model">firm.contract</field>
        <!--<field name="field_parent">children_ids if_want_to_add_Childs</field>-->
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_type"/>
            </list>
        </field>
    </record>


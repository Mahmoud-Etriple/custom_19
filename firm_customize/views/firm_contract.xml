            </list>
        </field>
    </record>

    <record id="issuing_office_action" model="ir.actions.act_window">
        <field name="name">Issuing Office</field>
        <field name="res_model">issuing.office</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="firm_contract_action" model="ir.actions.act_window">
        <field name="name">Firm Contract</field>
        <field name="res_model">firm.contract</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="firms_menu" 
              name="Firms" />
    
    <menuitem id="firm_contract_menu" 

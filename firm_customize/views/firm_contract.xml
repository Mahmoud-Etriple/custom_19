<data>
    <record id="firm_contract_form" model="ir.ui.view">
        <field name="name">firm.contract.form</field>
        <field name="model">firm.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancel'"
                            class="oe_highlight"/>
                    <button name="action_draft" string="Set Draft" type="object"
                            invisible="state != 'cancel'"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_crm"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-star">
                            <span>Opportunity</span>
                        </button>
                        <button name="action_view_sale"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar">
                            <span>Sale Orders</span>
                        </button>
                        <button name="action_view_project"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-puzzle-piece">
                            <span>Projects</span>
                        </button>
                        <button name="action_view_task"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check">
                            <span>Tasks</span>
                        </button>

                        <button name="action_view_expense"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar">
                            <span>Expenses</span>
                        </button>
                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <span>Customer Invoices</span>
                        </button>
                        <button name="action_view_bill"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <span>Vendor Bills</span>
                        </button>
                        <button name="action_view_firm_calender"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check">
                            <span>Calender</span>
                        </button>
                        <button name="action_view_firm_activity"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-puzzle-piece">
                            <span>Activity</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="parent_id"/>
                            <field name="vat"/>
                            <field name="responsible_name"/>
                            <field name="identification_no"/>
                            <field name="responsible_phone"/>
                            <field name="industry_id"/>
                            <field name="industry_code"/>
                            <span class="o_form_label o_td_label o_address_type" name="address_name">
                                <span>Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="activity_start_date"/>
                            <field name="activity_year"/>
                            <field name="company_type"/>
                            <field name="person_legal_form" invisible="company_type != 'person'"/>
                            <field name="legal_form" invisible="company_type == 'person'"/>
                            <field name="description"/>
                            <field name="is_eta"/>
                            <field name="token_end_date" invisible="not is_eta"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="documents_alerts" string="Documents / Alerts">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_document_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="name"/>
                                    <field name="document_type_id"/>
                                    <field name="issuing_office_id"/>
                                    <field name="state"/>
                                    <field name="last_update_date"/>
                                    <field name="alert_days"/>
                                    <field name="alert_users_ids" widget="many2many_tags" />
                                    <field name="tag_ids" widget="many2many_tags" />
                                    <field name="attachment_ids" widget="many2many_binary" />
                                    <field name="folder_path"/>
                                </list>
                            </field>
                        </page>
                        <page name="services_pricing" string="Services / Pricing">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_services_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="scope"/>
                                    <field name="category_id"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="total"/>
                                    <field name="project_manager_id"/>
                                    <field name="assignee_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>

                        <page name="tax_gates" string="Tax Gates">
                            <!-- add  context="{'default_field' : field}" to set default value -->
                            <field name="firm_tax_ids">
                                <list editable="bottom">
                                    <!-- add  domain="[('id','=',parent.field)]" to set default domain -->
                                    <field name="gate_link"/>
                                    <field name="user_name"/>
                                    <field name="password"/>
                                </list>
                            </field>
                        </page>


                    </notebook>
                    
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="firm_contract_calendar" model="ir.ui.view">
        <field name="name">firm.contract.calendar</field>
        <field name="model">firm.contract</field>
        <field name="arch" type="xml">
            <calendar date_start="start_date" mode="month">
                <field name="start_date"/>
            </calendar>
        </field>
    </record>
    <record id="firm_contract_tree" model="ir.ui.view">
        <field name="name">firm.contract.tree</field>
        <field name="model">firm.contract</field>
        <!--<field name="field_parent">children_ids if_want_to_add_Childs</field>-->
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_type"/>
            </list>
        </field>
    </record>


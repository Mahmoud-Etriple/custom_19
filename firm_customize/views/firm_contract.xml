    <record id="firm_document_type_tree" model="ir.ui.view">
        <field name="name">firm.document.type.tree</field>
        <field name="model">firm.document.type</field>
        <!--<field name="field_parent">children_ids if_want_to_add_Childs</field>-->
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="firm_document_type_action" model="ir.actions.act_window">
        <field name="name">Firm Document Type</field>
        <field name="res_model">firm.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="issuing_office_tree" model="ir.ui.view">
        <field name="name">firm.issuing.office.tree</field>
        <field name="model">issuing.office</field>
        <!--<field name="field_parent">children_ids if_want_to_add_Childs</field>-->
        <field name="arch" type="xml">
            <list editable="bottom">

<data>
    <record id="inherit_project_project_form" model="ir.ui.view">
        <field name="name">inherit.project.project.form</field>
        <field name="model">project.project</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="firm_contract_id"/>
            </field>
        </field>
    </record>
    
    <record id="inherit_project_task_form" model="ir.ui.view">
        <field name="name">inherit.project.task.form</field>
        <field name="model">project.task</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="role_ids" position="after">
                <field name="firm_contract_id"/>
            </field>
        </field>
    </record>
    
</data>
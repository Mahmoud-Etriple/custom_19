<data>
    <record id="inherit_account_move_form" model="ir.ui.view">
        <field name="name">inherit.account.move.form</field>
        <field name="model">account.move</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="delivery_date" position="after">
                <field name="firm_contract_id"/>
            </field>
        </field>
    </record>
    <record id="inherit_account_payment_form" model="ir.ui.view">
        <field name="name">inherit.account.payment.form</field>
        <field name="model">account.payment</field>
        <!--<field name="groups_id" eval="[(4, ref(''))]"/>-->
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <field name="firm_contract_id"/>
            </field>
        </field>
    </record>
</data>